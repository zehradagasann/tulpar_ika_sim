<?xml version="1.0"?>
<sdf version="1.8">
  <world name="s02_hedef_tespiti">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ARKA DUVAR (hedefin arkasında destek) -->
    <model name="arka_duvar">
      <static>true</static>
      <pose>10.1 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 2.0 2.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.1 2.0 2.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- A3 HEDEF TAHTASI (beyaz zemin) 420x297mm -->
    <model name="hedef_tahta">
      <static>true</static>
      <pose>10.0 0 0.365 0 0 0</pose>
      <link name="link">
        <visual name="zemin_beyaz">
          <geometry><box><size>0.04 0.42 0.297</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient></material>
        </visual>
        <!-- Dis halka (kirmizi, 12cm) -->
        <visual name="halka_dis">
          <pose>-0.02 0 0 0 0 0</pose>
          <geometry><box><size>0.04 0.12 0.12</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient></material>
        </visual>
        <!-- Merkez (kirmizi, 6cm) -->
        <visual name="merkez">
          <pose>-0.025 0 0 0 0 0</pose>
          <geometry><box><size>0.04 0.06 0.06</size></box></geometry>
          <material><ambient>1.0 0.0 0.0 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.04 0.42 0.297</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- MESAFE İŞARETİ (10m çizgisi) -->
    <model name="isaret_10m">
      <static>true</static>
      <pose>10 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 1.5 0.02</size></box></geometry>
          <material><ambient>1 1 0 1</ambient></material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
