<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>tulpar_ika_msgs</name>
  <version>0.1.0</version>

  <description>
    TULPAR insansız kara aracı için özel ROS 2 mesaj arayüzleri.
  </description>

  <maintainer email="zehradagasan09@gmail.com">
    zehra
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Paket derleme sistemi -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- .msg dosyalarından Python ve C++ arayüzleri üretir -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Mesaj dosyalarında kullandığımız bağımlılıklar -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Üretilen mesajların çalışma zamanı bağımlılığı -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Bu paketin bir ROS 2 interface paketi olduğunu belirtir -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Test ve linter bağımlılıkları -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
