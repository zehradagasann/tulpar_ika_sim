<?xml version="1.0"?>
<sdf version="1.8">
  <world name="e02_hizlanma">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Mesafe işaretleri (her 10m) -->
    <model name="isaret_10m">
      <static>true</static>
      <pose>10 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.1 2.0 0.5</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="isaret_20m">
      <static>true</static>
      <pose>20 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.1 2.0 0.5</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="isaret_30m">
      <static>true</static>
      <pose>30 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.1 2.0 0.5</size></box></geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
