<?xml version="1.0"?>
<robot name="tulpar_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="aluminium">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="camera_blue">
    <color rgba="0.0 0.2 0.8 1.0"/>
  </material>

  <material name="sensor_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="debug_red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.200" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.592 -0.225 0.110" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://tulpar_description/meshes/tulpar_govde_final.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1925" rpy="0 0 0"/>
      <geometry>
        <box size="1.150 1.207 0.615"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="65.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="9.94" ixy="0.0" ixz="0.0" iyy="9.21" iyz="0.0" izz="15.06"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
    <geometry>
      <cylinder radius="0.10" length="0.125"/>
    </geometry>
    <material name="aluminium"/>
  </visual>

      <collision>
        <geometry>
          <cylinder radius="0.20" length="0.12"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.5"/>
        <inertia ixx="0.039" ixy="0" ixz="0" iyy="0.039" iyz="0" izz="0.070"/>
      </inertial>
    </link>

    <joint name="joint_${name}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.1" friction="0.5"/>
    </joint>
  </xacro:macro>

  <!-- 18 Temmuz 2026: govde mesh'indeki 4 gomulu gercek tekerlek konumu (trimesh
       ile bulunan 16 parcalik tekerlek imzasi, her tekerlegin tam bounds ortasi)
       base_link'e donusturuldu - eski (0.4,0.58) degerine gore iz genisligi
       1.16m yerine 1.056m cikiyor (CLAUDE.md'nin daha once kaydettigi 1.06m
       degeriyle tutarli). Wheel_separation/wheel_radius DiffDrive plugin'inde
       hala eski (1.16/0.20) degerlerde - bu ayri, bilinen bir tartisma konusu
       (bkz. CLAUDE.md), burada sadece GORSEL konum duzeltildi, fizik parametreleri
       degistirilmedi. -->
  <xacro:wheel name="wheel_fl" x="0.39" y="0.528"/>
  <xacro:wheel name="wheel_rl" x="-0.39" y="0.528"/>
  <xacro:wheel name="wheel_fr" x="0.39" y="-0.528"/>
  <xacro:wheel name="wheel_rr" x="-0.39" y="-0.528"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- 18 Temmuz 2026: ilk tahmin (0.39,0.055,0.36) disliyle ayni merkezdeki
         disliye ait goze (hub) isaret ediyordu, yanlisti. Kullanicinin tarif
         ettigi "disliye gore onde/solda, alcakta" konumuna gore ikinci aday
         denendi - trimesh raw koordinati ~(180,70,266)mm. Henuz gorsel teyit
         edilmedi, iterasyon devam ediyor. -->
    <origin xyz="0.522 -0.045 0.376" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame"/>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Intel RealSense D435if depth camera. -->
  <link name="d435if_link">
    <visual>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="d435if_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435if_link"/>
    <!-- 18 Temmuz 2026: govde mesh'inde sasi onunde, yuksek detayli (67900 face)
         120x10x17mm'lik bir cubuk sekli bulundu (raw ~232.9,-19.0,219.8mm) -
         gercek Intel RealSense modeli olarak yorumlandi. Eski konum (0.58,0,0.53)
         0.2m fazla yukarida duruyordu. Mesh'teki cubugun uzun ekseni raw-X
         yonunde, bu da donusumden sonra base_link'in Y (yanal) eksenine denk
         geliyor - kutumuzun uzun ekseni varsayilan olarak X (ileri) oldugu icin
         yaw 90 derece dondurulerek gercek yonelime hizalandi. -->
    <origin xyz="0.611 0.008 0.33" rpy="0 0 1.5708"/>
  </joint>

  <link name="d435if_color_frame"/>
  <joint name="d435if_color_joint" type="fixed">
    <parent link="d435if_link"/>
    <child link="d435if_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="d435if_color_optical_frame"/>
  <joint name="d435if_color_optical_joint" type="fixed">
    <parent link="d435if_color_frame"/>
    <child link="d435if_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="d435if_depth_frame"/>
  <joint name="d435if_depth_joint" type="fixed">
    <parent link="d435if_link"/>
    <child link="d435if_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="d435if_depth_optical_frame"/>
  <joint name="d435if_depth_optical_joint" type="fixed">
    <parent link="d435if_depth_frame"/>
    <child link="d435if_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Raspberry Pi HQ camera with 16 mm telephoto lens (atis kamerasi). -->
  <link name="rpi_hq_camera_link">
    <visual>
      <origin xyz="-0.008 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.038 0.018"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <visual>
      <origin xyz="0.020 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.040"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.09"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="rpi_hq_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rpi_hq_camera_link"/>
    <!-- 18 Temmuz 2026: govde mesh'inde taret/gimbal alaninda, 138mm uzunlugunda
         teleskopik bir tup/skop sekli bulundu (raw ~286.8,169.0,306.8mm,
         faces=3620) - 16mm telefoto lensli atis/nisan kamerasi olarak
         yorumlandi, uzun ekseni zaten ileri (X) yonunde. Eski konum
         (0.58,-0.03,0.58) 0.16m ileride + 0.16m yukarida duruyordu. Gorsel
         teyit bekliyor. -->
    <origin xyz="0.423 0.062 0.417" rpy="0 0 0"/>
  </joint>

  <link name="rpi_hq_camera_optical_frame"/>
  <joint name="rpi_hq_camera_optical_joint" type="fixed">
    <parent link="rpi_hq_camera_link"/>
    <child link="rpi_hq_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Rear camera: SJCAM SJ4000 action camera. -->
  <link name="rear_camera_link">
    <visual>
      <geometry>
        <box size="0.059 0.041 0.029"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <mass value="0.058"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <!-- 18 Temmuz 2026: govde mesh'inde sasi arkasinda, yuksek detayli (11224 face)
         47x18x41mm'lik bir kutu bulundu (raw ~223.5,1173.5,276.9mm) - z 0.28'den
         0.387'ye duzeltildi. "6cm one" denemesi kullanici tarafindan yanlis
         yon olarak isaretlendi, x=-0.58'e geri alindi. Tam doğru konum icin
         mesh'te daha iyi bir referans bulunamadi - kullanicidan net koordinat/
         foto bekleniyor, ayri bir gorev olarak birakildi. -->
    <origin xyz="-0.58 0.0 0.387" rpy="0 0 3.14159"/>
  </joint>

  <link name="rear_camera_optical_frame"/>
  <joint name="rear_camera_optical_joint" type="fixed">
    <parent link="rear_camera_link"/>
    <child link="rear_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- GNSS anten (ZED-F9P RTK, roadmap Gun 7). 18 Temmuz 2026: govde mesh'inde
       "test cubugu" sanilan 617mm'lik ince direk (comp4592, raw x~50,y~1150,
       z 241.5-858.5mm) aslinda bir anten diregi olarak yeniden yorumlandi -
       kullanicinin "anten eksik" demesiyle tutarli, silinmedi. Anten linki
       direğin tepesine (raw z=858.5mm) eklendi. -->
  <link name="gnss_antenna_link">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gnss_antenna_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_antenna_link"/>
    <!-- raw direk ucu (~50,1150,858.5mm) base_link'e donusturuldu. -->
    <origin xyz="-0.558 -0.175 0.9685" rpy="0 0 0"/>
  </joint>

  <!-- Atis/nisan lazeri (roadmap: "servo+lazer diyot", izinli-atesleme role
       node'u). 18 Temmuz 2026: mesh'te ayri, belirgin bir lazer-diyot sekli
       bulunamadi (muhtemelen gercek tasarimda skopla ayni govdede/paralel) -
       rpi_hq_camera'nin (skop) hemen yanina, boresight hizali placeholder
       olarak eklendi. Gercek konum mekanik ekipten netlesince guncellenmeli. -->
  <link name="aim_laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.008" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="aim_laser_joint" type="fixed">
    <parent link="rpi_hq_camera_link"/>
    <child link="aim_laser_link"/>
    <origin xyz="0 0.04 0" rpy="0 1.5708 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_wheel_fl</left_joint>
      <left_joint>joint_wheel_rl</left_joint>
      <right_joint>joint_wheel_fr</right_joint>
      <right_joint>joint_wheel_rr</right_joint>
      <wheel_separation>1.16</wheel_separation>
      <wheel_radius>0.20</wheel_radius>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <max_wheel_torque>25.0</max_wheel_torque>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="ydlidar_tg30" type="gpu_lidar">
     <update_rate>2</update_rate>
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="d435if_link">
    <sensor name="d435if_depth" type="depth_camera">
    <update_rate>2</update_rate>

      <topic>/d435if/depth/image_raw</topic>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
       <image>
      <width>320</width>
      <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.20</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="rpi_hq_camera_link">
    <sensor name="rpi_hq_camera" type="camera">
      <update_rate>1</update_rate>
      <topic>/rpi_hq_camera/image_raw</topic>
      <camera>
        <horizontal_fov>0.6606</horizontal_fov>
        <image>
          <width>320</width>
  <height>240</height>

          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="rear_camera_link">
    <sensor name="rear_camera" type="camera">
      <update_rate>1</update_rate>
      <topic>/rear_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="wheel_fl">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="wheel_rl">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="wheel_fr">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="wheel_rr">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>
