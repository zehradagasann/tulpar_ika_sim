<?xml version="1.0"?>
<sdf version="1.8">
  <world name="s02_hedef_tespiti">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ARKA DUVAR (hedefin arkasında destek) -->
    <model name="arka_duvar">
      <static>true</static>
      <pose>10.1 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 2.0 2.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.1 2.0 2.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- A3 HEDEF TAHTASI (beyaz zemin) 420x297mm -->
    <model name="hedef_tahta">
      <static>true</static>
      <pose>10.0 0 0.365 0 0 0</pose>
      <link name="link">
        <visual name="zemin_beyaz">
          <geometry><box><size>0.04 0.42 0.297</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient></material>
        </visual>
        <!-- Dis halka (kirmizi, 12cm) -->
        <visual name="halka_dis">
          <pose>-0.02 0 0 0 0 0</pose>
          <geometry><box><size>0.04 0.12 0.12</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient></material>
        </visual>
        <!-- Merkez (kirmizi, 6cm) -->
        <visual name="merkez">
          <pose>-0.025 0 0 0 0 0</pose>
          <geometry><box><size>0.04 0.06 0.06</size></box></geometry>
          <material><ambient>1.0 0.0 0.0 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.04 0.42 0.297</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- MESAFE İŞARETİ (10m çizgisi) -->
    <model name="isaret_10m">
      <static>true</static>
      <pose>10 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 1.5 0.02</size></box></geometry>
          <material><ambient>1 1 0 1</ambient></material>
        </visual>
      </link>
    </model>

  <model name='tulpar'>
      <pose>0 0 0.005 0 0 0</pose>
    <link name='base_footprint'>
      <inertial>
        <pose>0.001616597510373444 0 0.1664273858921162 0 0 0</pose>
        <mass>60.25</mass>
        <inertia>
          <ixx>8.5534772448132781</ixx>
          <ixy>0</ixy>
          <ixz>-0.030140972614107881</ixz>
          <iyy>22.216427788215771</iyy>
          <iyz>0</iyz>
          <izz>27.224950543402489</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>0 0 0.3575 0 0 0</pose>
        <geometry>
          <box>
            <size>1.3160000000000001 1.2070000000000001 0.61499999999999999</size>
          </box>
        </geometry>
      </collision>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual'>
        <pose>0.600 -0.300 0.275 0 0 1.5708</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://tulpar_description/meshes/tulpar_yeni.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.9375 0.9375 0.9375 1</diffuse>
          <ambient>0.9375 0.9375 0.9375 1</ambient>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__camera_link_visual_1'>
        <pose>0.62 0 0.36499999999999999 0 0 0</pose>
        <geometry>
          <box>
            <size>0.089999999999999997 0.025000000000000001 0.025000000000000001</size>
          </box>
        </geometry>
        <material>
          <diffuse>0 0.25 1 1</diffuse>
          <ambient>0 0.25 1 1</ambient>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__lidar_link_visual_2'>
        <pose>0.29999999999999999 0 0.56500000000000006 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.040000000000000001</length>
            <radius>0.040000000000000001</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0 0 0 1</diffuse>
          <ambient>0 0 0 1</ambient>
        </material>
      </visual>
      <sensor name='realsense_d455' type='depth_camera'>
        <update_rate>30</update_rate>
        <topic>camera/depth</topic>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.40000000000000002</near>
            <far>15</far>
          </clip>
        </camera>
        <pose>0.62 0 0.36499999999999999 0 0 0</pose>
        <gz_frame_id>camera_link</gz_frame_id>
      </sensor>
      <sensor name='rplidar_s2' type='gpu_lidar'>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>800</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415899999999999</min_angle>
              <max_angle>3.1415899999999999</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.050000000000000003</min>
            <max>30</max>
            <resolution>0.029999999999999999</resolution>
          </range>
        </lidar>
        <pose>0.29999999999999999 0 0.56499999999999995 0 0 0</pose>
        <gz_frame_id>lidar_link</gz_frame_id>
      </sensor>
    </link>
    <joint name='joint_wheel_fl' type='revolute'>
      <pose relative_to='base_footprint'>0.40000000000000002 0.52000000000000002 0.16500000000000001 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_fl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name='wheel_fl'>
      <pose relative_to='joint_wheel_fl'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia></inertial>
      <collision name='wheel_fl_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
    </link>
    <joint name='joint_wheel_fr' type='revolute'>
      <pose relative_to='base_footprint'>0.40000000000000002 -0.52000000000000002 0.16500000000000001 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_fr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name='wheel_fr'>
      <pose relative_to='joint_wheel_fr'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia></inertial>
      <collision name='wheel_fr_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
    </link>
    <joint name='joint_wheel_rl' type='revolute'>
      <pose relative_to='base_footprint'>-0.40000000000000002 0.52000000000000002 0.16500000000000001 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_rl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name='wheel_rl'>
      <pose relative_to='joint_wheel_rl'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia></inertial>
      <collision name='wheel_rl_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
    </link>
    <joint name='joint_wheel_rr' type='revolute'>
      <pose relative_to='base_footprint'>-0.40000000000000002 -0.52000000000000002 0.16500000000000001 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_rr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name='wheel_rr'>
      <pose relative_to='joint_wheel_rr'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia></inertial>
      <collision name='wheel_rr_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
    </link>
    <plugin name='gz::sim::systems::DiffDrive' filename='gz-sim-diff-drive-system'>
      <left_joint>joint_wheel_fl</left_joint>
      <left_joint>joint_wheel_rl</left_joint>
      <right_joint>joint_wheel_fr</right_joint>
      <right_joint>joint_wheel_rr</right_joint>
      <wheel_separation>1.04</wheel_separation>
      <wheel_radius>0.165</wheel_radius>
      <max_linear_velocity>0.785</max_linear_velocity>
      <max_angular_velocity>7.854</max_angular_velocity>
      <max_wheel_torque>21.6</max_wheel_torque>
      <max_linear_acceleration>5.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
    <frame name='camera_joint' attached_to='base_link'><pose>0.62 0 0.2 0 0 0</pose></frame>
    <frame name='camera_link' attached_to='camera_joint'><pose>0 0 0 0 0 0</pose></frame>
    <frame name='lidar_joint' attached_to='base_link'><pose>0.3 0 0.4 0 0 0</pose></frame>
    <frame name='lidar_link' attached_to='lidar_joint'><pose>0 0 0 0 0 0</pose></frame>
    <frame name='base_joint' attached_to='base_footprint'><pose>0 0 0.165 0 0 0</pose></frame>
    <frame name='base_link' attached_to='base_joint'><pose>0 0 0 0 0 0</pose></frame>
  </model>

  </world>
</sdf>
