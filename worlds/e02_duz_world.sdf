<?xml version="1.0"?>
<sdf version="1.8">
  <world name="e02_hizlanma">

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Mesafe işaretleri (her 10m) -->
    <model name="isaret_10m">
      <static>true</static>
      <pose>10 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.1 2.0 0.5</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="isaret_20m">
      <static>true</static>
      <pose>20 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.1 2.0 0.5</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="isaret_30m">
      <static>true</static>
      <pose>30 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v"><pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.1 2.0 0.5</size></box></geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
      </link>
    </model>

  <model name='tulpar'>
    <pose>0 0 0.005 0 0 0</pose>
    <link name='base_footprint'>
      <inertial>
        <pose>0.001616597510373444 0 0.1664273858921162 0 0 0</pose>
        <mass>60.25</mass>
        <inertia>
          <ixx>8.5534772448132781</ixx>
          <ixy>0</ixy>
          <ixz>-0.030140972614107881</ixz>
          <iyy>22.216427788215771</iyy>
          <iyz>0</iyz>
          <izz>27.224950543402489</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>0 0 0.3075 0 0 0</pose>
        <geometry><box><size>1.316 1.207 0.615</size></box></geometry>
      </collision>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual'>
        <pose>0.600 -0.300 0.275 0 0 1.5708</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://tulpar_description/meshes/tulpar_yeni.stl</uri>
          </mesh>
        </geometry>
        <material><diffuse>0.9375 0.9375 0.9375 1</diffuse><ambient>0.9375 0.9375 0.9375 1</ambient></material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__camera_link_visual_1'>
        <pose>0.62 0 0.365 0 0 0</pose>
        <geometry><box><size>0.09 0.025 0.025</size></box></geometry>
        <material><diffuse>0 0.25 1 1</diffuse><ambient>0 0.25 1 1</ambient></material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__lidar_link_visual_2'>
        <pose>0.3 0 0.565 0 0 0</pose>
        <geometry><cylinder><length>0.04</length><radius>0.04</radius></cylinder></geometry>
        <material><diffuse>0 0 0 1</diffuse><ambient>0 0 0 1</ambient></material>
      </visual>
      <sensor name='realsense_d455' type='depth_camera'>
        <update_rate>30</update_rate>
        <topic>camera/depth</topic>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image><width>848</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.4</near><far>6</far></clip>
        </camera>
        <pose>0.62 0 0.365 0 0 0</pose>
        <gz_frame_id>camera_link</gz_frame_id>
      </sensor>
      <sensor name='rplidar_s2' type='gpu_lidar'>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>800</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.05</min><max>30</max><resolution>0.03</resolution></range>
        </lidar>
        <pose>0.3 0 0.565 0 0 0</pose>
        <gz_frame_id>lidar_link</gz_frame_id>
      </sensor>
    </link>
    <joint name='joint_wheel_fl' type='revolute'>
      <pose relative_to='base_footprint'>0.4 0.52 0.165 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_fl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>
    <link name='wheel_fl'>
      <pose relative_to='joint_wheel_fl'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia>
      </inertial>
      <collision name='wheel_fl_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name='joint_wheel_fr' type='revolute'>
      <pose relative_to='base_footprint'>0.4 -0.52 0.165 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_fr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>
    <link name='wheel_fr'>
      <pose relative_to='joint_wheel_fr'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia>
      </inertial>
      <collision name='wheel_fr_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name='joint_wheel_rl' type='revolute'>
      <pose relative_to='base_footprint'>-0.4 0.52 0.165 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_rl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>
    <link name='wheel_rl'>
      <pose relative_to='joint_wheel_rl'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia>
      </inertial>
      <collision name='wheel_rl_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name='joint_wheel_rr' type='revolute'>
      <pose relative_to='base_footprint'>-0.4 -0.52 0.165 -1.5708 0 0</pose>
      <parent>base_footprint</parent><child>wheel_rr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-inf</lower><upper>inf</upper></limit>
        <dynamics><damping>0.1</damping><friction>0.5</friction><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>
    <link name='wheel_rr'>
      <pose relative_to='joint_wheel_rr'>0 0 0 0 0 0</pose>
      <inertial><pose>0 0 0 0 0 0</pose><mass>3.5</mass>
        <inertia><ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.024</iyy><iyz>0</iyz><izz>0.048</izz></inertia>
      </inertial>
      <collision name='wheel_rr_collision'><pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><length>0.12</length><radius>0.165</radius></cylinder></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>1</kd></ode></contact>
          <friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
      </collision>
    </link>
    <plugin name='gz::sim::systems::DiffDrive' filename='gz-sim-diff-drive-system'>
      <left_joint>joint_wheel_fl</left_joint>
      <left_joint>joint_wheel_rl</left_joint>
      <right_joint>joint_wheel_fr</right_joint>
      <right_joint>joint_wheel_rr</right_joint>
      <wheel_separation>1.04</wheel_separation>
      <wheel_radius>0.165</wheel_radius>
      <max_linear_velocity>0.785</max_linear_velocity>
      <max_angular_velocity>7.854</max_angular_velocity>
      <max_wheel_torque>21.6</max_wheel_torque>
      <max_linear_acceleration>5.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
    <frame name='camera_joint' attached_to='base_link'><pose>0.62 0 0.2 0 0 0</pose></frame>
    <frame name='camera_link' attached_to='camera_joint'><pose>0 0 0 0 0 0</pose></frame>
    <frame name='lidar_joint' attached_to='base_link'><pose>0.3 0 0.4 0 0 0</pose></frame>
    <frame name='lidar_link' attached_to='lidar_joint'><pose>0 0 0 0 0 0</pose></frame>
    <frame name='base_joint' attached_to='base_footprint'><pose>0 0 0.165 0 0 0</pose></frame>
    <frame name='base_link' attached_to='base_joint'><pose>0 0 0 0 0 0</pose></frame>
  </model>

  </world>
</sdf>
