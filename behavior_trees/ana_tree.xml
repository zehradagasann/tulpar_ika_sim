<?xml version="1.0"?>
<!--
  ana_tree.xml — TULPAR İKA ana Behavior Tree TASLAĞI (BehaviorTree.CPP v4)

  Amaç: Sistem hazır olduktan sonra parkur boyunca varsayılan davranış
  otonom sürüştür (Nav2). Kamera bir tabela/hedef algıladığında Nav2
  durdurulur, hedef kilitlenir, atış (lazer işaretleme) yapılır ve
  otonom sürüşe geri dönülür. Dik eğim rampasında işaretli stop
  noktasına ulaşıldığında araç tam durup en az 2 saniye bekler, sonra
  devam eder (şartname madde 6.10). Bu döngü parkur bitene kadar
  tekrarlanır.

  KAPSAM: Bu BT sadece TAM-OTONOM koşuyu modeller (şartname madde 1.1 —
  2. Koşu). Manuel koşu (1. Koşu) bu ağacın dışında, RC/ELRS katmanında
  yönetilir. Ayrıca parkurdaki her tabela/bölüm için ayrı bir BT node'u
  yoktur — sadece davranış değişikliği gerektiren tabelalar (atış, dik
  eğim stop) burada node olarak modellenmiştir. Su geçişi, çakıllı yol,
  yan eğim, dik engel, trafik konileri, kayar engel ve engebeli arazi
  gibi diğer parkur bölümleri Nav2/costmap parametreleriyle sürekli
  (BT'ye ayrı dal eklemeden) geçilir.

  DÜZELTME (18 Temmuz 2026, Nav2 doğrulama oturumu) — eskiden burada
  Repeat(num_cycles=-1) + ForceSuccess sarmalayıcısı vardı ("dallardan
  hiçbiri başarılı olmasa da Repeat'e SUCCESS görünsün, döngü kalıcı
  durmasın" amacıyla). Gerçek Nav2 stack'iyle canlı test edildiğinde bu
  desenin ciddi bir performans bug'ı olduğu ortaya çıktı: BT.CPP'nin
  Repeat decorator'ü, child SUCCESS döndüğünde onu AYNI tickOnce()
  çağrısı içinde senkron olarak tekrar tikliyor. ForceSuccess her tick'te
  ReactiveFallback'in sonucunu (FAILURE olsa bile, ki henüz hedef pose
  yokken OtonomSurus'un FAILURE dönmesi normal/sürekli bir durumdur)
  anında SUCCESS'e çevirdiği için, Repeat sonsuz senkron bir döngüye
  giriyordu — main.cpp'deki 100ms'lik tree.sleep() hiç devreye giremiyor,
  bir CPU çekirdeği kilitleniyor, saniyede yüz binlerce log satırı
  üretiliyordu (10 saniyede ~1.2 milyon satır / ~100MB ölçüldü).
  Doğru çözüm Repeat/ForceSuccess'i kaldırıp kökü doğrudan
  ReactiveFallback yapmak ve "FAILURE dönünce program kapanmasın"
  isteğini main.cpp'nin dış döngüsünde çözmektir (bkz. bt_executor_main.cpp
  - dış döngü artık tick sonucundan bağımsız sürüyor, sleep her tick
  sonrası çağrılıyor). Bu hem sonsuz senkron döngüyü ortadan kaldırır hem
  de orijinal "kalıcı durmasın" isteğini karşılar - BT.CPP'nin önerdiği
  standart kullanım şeklidir.

  DURUM: 9 node'un tamamı `tulpar_bt` paketinde (src/tulpar_ika_sim/tulpar_bt/)
  gerçek C++ implementasyonlarına kavuştu — placeholder değiller. İki grup var:
    - TAM İMPLEMENTE (donanıma bağımlı değil): WaitForSystemReady,
      OtonomSurus, ModDegisimiYap, DevamEt, StopNoktasindaMi, DurVeBekle
    - YAZILIMSAL TAMAMLANDI (donanım/başka ekip üyesinin verisi bekleniyor):
      TabelaAlgılandiMi (Emin'in görüntü işleme çıktısı — 17 Temmuz 2026'dan
      itibaren /sign_detected [tulpar_ika_msgs/SignDetectionArray] dinliyor,
      sadece action==ACTION_ENTER_SHOOTING_ZONE tetikliyor; eski
      /tabela_tespit std_msgs/Bool placeholder'ı ARTIK KULLANILMIYOR),
      HedefTespitYap ve AtisYap (lazer donanımı — /hedef_tespit_yap
      ve /atis_yap servisleri; gerçek servis yoksa simulate_mode ile
      simüle edilir, "SİMÜLASYON" olarak loglanır)
  Detaylar için ilgili .hpp dosyalarının başındaki yorumlara bakın.

  Test/çalıştırma: `ros2 launch tulpar_bt bt_executor.launch.py` (veya
  `ros2 run tulpar_bt bt_executor`). Nav2 ayakta değilse agac kurulumu
  otomatik olarak retry eder (crash etmez). Bu dosya Groot2 ile de
  görsel olarak açılıp incelenebilir.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="MainTree">
      <WaitForSystemReady name="Bekleme"/>
      <ReactiveFallback name="TabelaMiOtonomSurusMu">
        <Sequence name="TabelaAlgılandiVeAtisAkisi">
          <TabelaAlgılandiMi name="TabelaAlgılandiMi"/>
          <ModDegisimiYap name="ModDegisimiYap"/>
          <HedefTespitYap name="HedefTespitYap"/>
          <AtisYap name="AtisYap"/>
          <DevamEt name="DevamEt"/>
        </Sequence>
        <Sequence name="DikEgimStopAkisi">
          <StopNoktasindaMi name="StopNoktasindaMi"/>
          <DurVeBekle name="DurVeBekle"/>
        </Sequence>
        <OtonomSurus name="OtonomSurus"/>
      </ReactiveFallback>
    </Sequence>
  </BehaviorTree>

  <!--
    TreeNodesModel: tulpar_bt paketindeki gerçek C++ node'larının tip/ID
    tanımları (Groot2'nin ağacı doğru şekilde gösterebilmesi için).
  -->
  <TreeNodesModel>
    <Action ID="WaitForSystemReady">
      <description>TAM İMPLEMENTE. Nav2 lifecycle node'larının (varsayılan: bt_navigator, controller_server, planner_server) hepsi ACTIVE olana kadar lifecycle_msgs/GetState servisleriyle bekler.</description>
    </Action>
    <Condition ID="TabelaAlgılandiMi">
      <description>YAZILIMSAL TAMAMLANDI — Emin'in görüntü işleme çıktısı bekleniyor. /sign_detected (tulpar_ika_msgs/SignDetectionArray) topic'ine subscribe olur, sadece action==ACTION_ENTER_SHOOTING_ZONE (9) taşıyan tespitte SUCCESS döner; elle test edilebilir: ros2 topic pub /sign_detected tulpar_ika_msgs/msg/SignDetectionArray "{detections: [{action: 9}]}"</description>
    </Condition>
    <Action ID="ModDegisimiYap">
      <description>TAM İMPLEMENTE. navigate_to_pose action client'ı ile Nav2'nin aktif goal'unu gerçekten iptal eder (async_cancel_all_goals).</description>
    </Action>
    <Action ID="HedefTespitYap">
      <description>YAZILIMSAL TAMAMLANDI — lazer/hedef kilitleme donanımı bekleniyor. /hedef_tespit_yap (std_srvs/Trigger) service client; servis yoksa simulate_mode ile simüle edip SUCCESS döner ("SİMÜLASYON" logu).</description>
    </Action>
    <Action ID="AtisYap">
      <description>YAZILIMSAL TAMAMLANDI — lazer donanımı bekleniyor. /atis_yap (std_srvs/Trigger) service client; servis yoksa simulate_mode ile simüle edip SUCCESS döner ("SİMÜLASYON" logu).</description>
    </Action>
    <Action ID="DevamEt">
      <description>TAM İMPLEMENTE. navigate_to_pose action server'ının tekrar hazır olduğunu doğrular (action_server_is_ready), hazırsa SUCCESS döner.</description>
    </Action>
    <Condition ID="StopNoktasindaMi">
      <description>TAM İMPLEMENTE. /odom (nav_msgs/Odometry) subscriber ile gerçek pozisyonu şartname madde 6.10 stop noktalarıyla karşılaştırır; her nokta en fazla bir kez tetiklenir.</description>
    </Condition>
    <Action ID="DurVeBekle">
      <description>TAM İMPLEMENTE. /cmd_vel'e sıfır Twist basarak aracı gerçekten durdurur, gerçek wall-clock süreyle en az 2.0 saniye (bekleme_sn portu) bekler.</description>
    </Action>
    <Action ID="OtonomSurus">
      <description>TAM İMPLEMENTE. nav2_behavior_tree::BtActionNode tabanlı gerçek Nav2 NavigateToPose action client'ı. Hedef pose /tulpar_bt/hedef_pose (geometry_msgs/PoseStamped) topic'inden alınır.</description>
    </Action>
  </TreeNodesModel>
</root>
