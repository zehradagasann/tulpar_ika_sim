<?xml version="1.0"?>
<robot name="tulpar_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="aluminium">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="camera_blue">
    <color rgba="0.0 0.2 0.8 1.0"/>
  </material>

  <material name="sensor_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <xacro:property name="cad_center_x" value="0.225"/>
  <xacro:property name="cad_center_y" value="0.592375"/>
  <xacro:property name="cad_z_offset" value="0.109663086"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.165" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${cad_center_y} ${-cad_center_x} ${cad_z_offset}" rpy="0 0 1.57079633"/>
      <geometry>
        <mesh filename="package://tulpar_description/meshes/tulpar_ika_assembly_visual.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <!-- 21 Temmuz 2026: eski deger (size 1.1666 1.2368 0.615, origin_z=0.1925)
           X/Y eksenleri ters (gercek: X=1.2368 Y=1.1666, trimesh ile govde
           mesh'inin gercek dunyaya-donusturulmus bbox'indan hesaplandi) VE
           yukseklik hala eski/yanlis degerdeydi (0.615 - "duzeltildi"
           denmisti ama sadece X/Y footprint'e islenmisti, bu collision box'a
           hic yansimamis). Gercek yukseklik 1.1332m (govde mesh'inin tam Z
           araligindan), merkez z=0.4016 - onceki kutu aracin ust yarisini
           (turret/govde ustu) hic kapsamiyordu. -->
      <origin xyz="0 0 0.4016" rpy="0 0 0"/>
      <geometry>
        <box size="1.2368 1.1666 1.1332"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="65.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="9.94" ixy="0.0" ixz="0.0" iyy="9.21" iyz="0.0" izz="15.06"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="0.165" length="0.125"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.165" length="0.12"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.5"/>
        <inertia ixx="0.024" ixy="0" ixz="0" iyy="0.024" iyz="0" izz="0.048"/>
      </inertial>
    </link>

    <joint name="joint_${name}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.1" friction="0.5"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="wheel_fl" x="0.4" y="0.52"/>
  <xacro:wheel name="wheel_rl" x="-0.4" y="0.52"/>
  <xacro:wheel name="wheel_fr" x="0.4" y="-0.52"/>
  <xacro:wheel name="wheel_rr" x="-0.4" y="-0.52"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <mesh filename="package://tulpar_description/meshes/lidar2_v1_1_visual.stl"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <mass value="0.275"/>
      <inertia ixx="0.00024" ixy="0" ixz="0" iyy="0.00019" iyz="0" izz="0.00034"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.010642665 -0.64000642 0.351677956" rpy="0 0 4.71238898"/>
  </joint>

  <link name="laser_frame"/>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="d435if_link">
    <visual>
      <geometry>
        <box size="0.124 0.026 0.029"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
    <inertial>
      <mass value="0.313"/>
      <inertia ixx="0.00018" ixy="0" ixz="0" iyy="0.00055" iyz="0" izz="0.00058"/>
    </inertial>
  </link>

  <joint name="d435if_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435if_link"/>
    <origin xyz="0.618375 0.0075 0.329663086" rpy="-1.57079633 0 -1.57079633"/>
  </joint>

  <link name="d435if_color_frame"/>
  <joint name="d435if_color_joint" type="fixed">
    <parent link="d435if_link"/>
    <child link="d435if_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="d435if_color_optical_frame"/>
  <joint name="d435if_color_optical_joint" type="fixed">
    <parent link="d435if_color_frame"/>
    <child link="d435if_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="d435if_depth_frame"/>
  <joint name="d435if_depth_joint" type="fixed">
    <parent link="d435if_link"/>
    <child link="d435if_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="d435if_depth_optical_frame"/>
  <joint name="d435if_depth_optical_joint" type="fixed">
    <parent link="d435if_depth_frame"/>
    <child link="d435if_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="rpi_hq_camera_link">
    <visual>
      <origin xyz="-0.008 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.038 0.018"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <visual>
      <origin xyz="0.020 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.040"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.09"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="rpi_hq_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rpi_hq_camera_link"/>
    <origin xyz="0.492373 0.049000 0.424228" rpy="0 0 0"/>
  </joint>

  <link name="rpi_hq_camera_optical_frame"/>
  <joint name="rpi_hq_camera_optical_joint" type="fixed">
    <parent link="rpi_hq_camera_link"/>
    <child link="rpi_hq_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="rear_camera_link">
    <visual>
      <geometry>
        <box size="0.059 0.041 0.029"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <mass value="0.058"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin xyz="-0.58687500 -0.00155476 0.38655832" rpy="0 0 3.14159"/>
  </joint>

  <link name="rear_camera_optical_frame"/>
  <joint name="rear_camera_optical_joint" type="fixed">
    <parent link="rear_camera_link"/>
    <child link="rear_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="wifi_radio_link">
    <visual>
      <geometry>
        <mesh filename="package://tulpar_description/meshes/Bullet_2hp_Ubiquiti_1.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.213"/>
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.00006"/>
    </inertial>
  </link>

  <joint name="wifi_radio_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wifi_radio_link"/>
    <origin xyz="-0.55664594 -0.163840659 0.142025727" rpy="0 0.019476555 3.14159265"/>
  </joint>

  <link name="wifi_antenna_left_link">
    <visual>
      <geometry>
        <mesh filename="package://tulpar_description/meshes/WIFI_ANTENNA_P3526_1.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
  </link>

  <joint name="wifi_antenna_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wifi_antenna_left_link"/>
    <origin xyz="0.236314539 0.001977871 0.166971529" rpy="0 0 0"/>
  </joint>

  <link name="wifi_antenna_right_link">
    <visual>
      <geometry>
        <mesh filename="package://tulpar_description/meshes/WIFI_ANTENNA_P3526_2.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
  </link>

  <joint name="wifi_antenna_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wifi_antenna_right_link"/>
    <origin xyz="0.305717539 0.087677871 0.166971529" rpy="0 0 3.14159265"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1925" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="wt901c_imu" type="imu">
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_wheel_fl</left_joint>
      <left_joint>joint_wheel_rl</left_joint>
      <right_joint>joint_wheel_fr</right_joint>
      <right_joint>joint_wheel_rr</right_joint>
      <wheel_separation>1.04</wheel_separation>
      <wheel_radius>0.165</wheel_radius>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <max_wheel_torque>25.0</max_wheel_torque>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="ydlidar_tg30" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>800</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="d435if_link">
    <sensor name="d455_depth" type="depth_camera">
      <update_rate>30</update_rate>
      <topic>/d435if/depth/image_raw</topic>
      <gz_frame_id>d435if_depth_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>848</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.20</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="rpi_hq_camera_link">
    <sensor name="rpi_hq_camera" type="camera">
      <update_rate>1</update_rate>
      <topic>/rpi_hq_camera/image_raw</topic>
      <camera>
        <horizontal_fov>0.6606</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="rear_camera_link">
    <sensor name="rear_camera" type="camera">
      <update_rate>1</update_rate>
      <topic>/rear_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="wheel_fl">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="wheel_rl">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="wheel_fr">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="wheel_rr">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>